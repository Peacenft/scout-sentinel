{
  "name": "scout-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test:integration": "vitest run tests/http.integration.test.ts",
    "test:db:prepare": "tsx scripts/prepare-test-db.ts",
    "db:migrate": "node dist/scripts/migrate.js",
    "binance:probe": "tsx scripts/probe-binance.ts",
    "secrets:generate": "tsx scripts/generate-production-secrets.ts",
    "cloudflare:types": "wrangler types --strict-vars=false",
    "cloudflare:check": "pnpm build && wrangler deploy --dry-run",
    "cloudflare:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  }
}
